{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1000px",
      "wideSize": "1000px"
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "custom": true,
      "palette": [
        { "slug": "black", "name": "Black", "color": "#000000" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "pale-yellow", "name": "Pale Yellow", "color": "#ffff99" },
        { "slug": "gold", "name": "Gold", "color": "#ffcc00" },
        { "slug": "red", "name": "Red", "color": "#ff0000" },
        { "slug": "crimson", "name": "Crimson", "color": "#cc0000" },
        { "slug": "rule-gray", "name": "Rule Gray", "color": "#999999" }
      ]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "arial",
          "name": "Arial",
          "fontFamily": "Arial, Helvetica, sans-serif"
        },
        {
          "slug": "verdana",
          "name": "Verdana",
          "fontFamily": "Verdana, Geneva, Tahoma, sans-serif"
        },
        {
          "slug": "georgia",
          "name": "Georgia",
          "fontFamily": "Georgia, 'Times New Roman', Times, serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "11px" },
        { "slug": "medium", "name": "Medium", "size": "13px" },
        { "slug": "regular", "name": "Regular", "size": "16px" },
        { "slug": "large", "name": "Large", "size": "18px" },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "30px",
          "fluid": { "min": "24px", "max": "30px" }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "Small", "size": "0.5rem" },
        { "slug": "30", "name": "Medium", "size": "1rem" },
        { "slug": "40", "name": "Large", "size": "1.5rem" },
        { "slug": "50", "name": "X-Large", "size": "2.5rem" },
        { "slug": "60", "name": "XX-Large", "size": "clamp(2rem, 4vw, 3.125rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|black",
      "text": "var:preset|color|white"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|arial",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|pale-yellow" },
        ":hover": { "color": { "text": "var:preset|color|red" } }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|arial",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "textTransform": "uppercase"
        },
        "color": { "text": "var:preset|color|white" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|verdana",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400"
        },
        "color": { "text": "var:preset|color|gold" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|verdana",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "400"
        },
        "color": { "text": "var:preset|color|white" }
      }
    }
  }
}
