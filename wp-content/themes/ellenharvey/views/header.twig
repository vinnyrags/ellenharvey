{# Site header: name wordmark + primary nav, both right-aligned. Used on every
   page — on inner pages it sits in the right photographic column; on home
   _home.scss overlays it on the hero. #}
<header class="site-header">
    <p class="site-header__logo">
        <a href="{{ site.url }}" rel="home">
            <img class="site-header__wordmark"
                 src="{{ function('get_theme_file_uri', 'src/Providers/Theme/assets/images/name2.png') }}?v={{ function('filemtime', function('get_theme_file_path', 'src/Providers/Theme/assets/images/name2.png')) }}"
                 width="198" height="33"
                 alt="{{ site.name }}" />
        </a>
    </p>
    <nav class="site-header__nav" aria-label="Primary navigation">
        {{ function('wp_nav_menu', {
            theme_location: 'primary',
            container: false,
            fallback_cb: false,
            menu_id: '',
            menu_class: 'site-nav'
        }) }}
    </nav>
</header>
