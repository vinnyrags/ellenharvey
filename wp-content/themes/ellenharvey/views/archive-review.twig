{% extends "base.twig" %}

{# Reviews archive — press quotes grouped by production, each show heading a
   block of quotes with a back-to-top link, mirroring the original
   reviews.htm. Renders inside the standard two-column content panel. #}

{% block content %}
    <div class="reviews" id="top">
        <h1>{{ title }}</h1>

        {% for group in groups %}
            <section class="reviews__show">
                <h2 class="reviews__show-title">{{ group.production.title }}</h2>

                {% for review in group.reviews %}
                    <blockquote class="reviews__quote">
                        <p class="reviews__quote-text">{{ review.quote }}</p>
                        {% if review.source %}
                            <cite class="reviews__quote-source">{{ review.source }}</cite>
                        {% endif %}
                    </blockquote>
                {% endfor %}

                <p class="reviews__back-to-top"><a href="#top">back to top</a></p>
            </section>
        {% else %}
            <p>Reviews coming soon.</p>
        {% endfor %}
    </div>
{% endblock %}
