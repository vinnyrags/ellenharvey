{% extends "base.twig" %}

{# Résumé archive — credits grouped into sections, each section a three-column
   table of production / role / venue, mirroring the original resume.htm.
   Header credentials and the training/skills/awards footer come from the
   Résumé Details options page. Renders inside the dark content panel. #}

{% block content %}
    <div class="resume">
        <h1>{{ title }}</h1>

        {# Credentials, mirroring the original: the union line as a gold heading,
           then eyes/hair/vocal range as one pipe-separated line beneath it. #}
        {% set d = details %}
        {% if d.unions %}
            <p class="resume__unions">{{ d.unions }}</p>
        {% endif %}
        {% set stats = [] %}
        {% if d.eyes %}{% set stats = stats|merge(['Eyes: ' ~ d.eyes]) %}{% endif %}
        {% if d.hair %}{% set stats = stats|merge(['Hair: ' ~ d.hair]) %}{% endif %}
        {% if d.vocal_range %}{% set stats = stats|merge(['Vocal Range: ' ~ d.vocal_range]) %}{% endif %}
        {% if stats %}
            <p class="resume__stats">{{ stats|join(' | ') }}</p>
        {% endif %}

        {% for group in groups %}
            <section class="resume__section">
                <h2 class="resume__section-title">{{ group.section.title }}</h2>

                <table class="resume__credits">
                    {% for credit in group.credits %}
                        <tr class="resume__credit">
                            <th class="resume__production" scope="row">
                                {{ credit.title }}
                                {% if credit.note %}
                                    <span class="resume__note">({{ credit.note }})</span>
                                {% endif %}
                            </th>
                            <td class="resume__role">{{ credit.role }}</td>
                            <td class="resume__venue">{{ credit.venue }}</td>
                        </tr>
                    {% endfor %}
                </table>
            </section>
        {% else %}
            <p>Résumé coming soon.</p>
        {% endfor %}

        {% if d.footer_note %}
            <p class="resume__footer-note">{{ d.footer_note }}</p>
        {% endif %}

        {% if d.training %}
            <section class="resume__detail">
                <h2>Training</h2>
                {{ d.training }}
            </section>
        {% endif %}

        {% if d.skills %}
            <section class="resume__detail">
                <h2>Skills</h2>
                {{ d.skills }}
            </section>
        {% endif %}

        {% if d.awards %}
            <section class="resume__detail">
                <h2>Awards</h2>
                {{ d.awards }}
            </section>
        {% endif %}

        {% if d.pdf or d.headshots %}
            <div class="resume__downloads">
                {% if d.pdf %}
                    <a class="resume__download" href="{{ d.pdf.url }}" target="_blank" rel="noopener">Download PDF</a>
                {% endif %}
                {% if d.headshots %}
                    <div class="resume__headshots">
                        <span class="resume__download">Download Headshots:</span>
                        <span class="resume__headshots-thumbs">
                            {% for shot in d.headshots %}
                                <a href="{{ shot.url }}" target="_blank" rel="noopener">
                                    <img src="{{ shot.sizes.medium|default(shot.url) }}" alt="{{ shot.alt|default('Ellen Harvey headshot') }}" loading="lazy">
                                </a>
                            {% endfor %}
                        </span>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
