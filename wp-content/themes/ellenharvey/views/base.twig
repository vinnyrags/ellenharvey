{% block html_head_container %}
    {% include 'head.twig' %}
    {% block head %}{% endblock %}
    </head>
{% endblock %}

<body {{ function('body_class') }}>
    {{ function('wp_body_open') }}
    <a class="skip-link screen-reader-text" href="#wp--skip-link--target">{{ _e('Skip to content') }}</a>

    {# The stage: a 1000px centred column with the header overlaid on top (see
       layout/_frame.scss). Each page's own block content provides the rest — a
       core/group with a background photo wrapping a content panel column. #}
    <div class="site-layout">
        {% block header %}
            {% include 'header.twig' %}
        {% endblock %}

        <main id="wp--skip-link--target" class="site-main">
            {% block main %}
                {{ post.content }}
            {% endblock %}
        </main>
    </div>

    {% block footer %}
        {% include 'footer.twig' %}
        {{ function('wp_footer') }}
    {% endblock %}
</body>
</html>
